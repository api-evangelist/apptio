{
  "opencollection": "1.0.0",
  "info": {
    "name": "Apptio Technology Business Management Budgets API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Budgets",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Apptio - List Budgets",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.apptio.com/v1/budgets",
            "params": [
              {
                "name": "fiscalYear",
                "value": "",
                "type": "query",
                "description": "Filter by fiscal year"
              }
            ]
          },
          "docs": "Returns a list of IT budget plans and their current spending status"
        }
      ]
    }
  ],
  "bundled": true
}