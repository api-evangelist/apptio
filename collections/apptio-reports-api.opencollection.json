{
  "opencollection": "1.0.0",
  "info": {
    "name": "Apptio Technology Business Management Budgets Reports API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Reports",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Apptio - List Reports",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.apptio.com/v1/reports"
          },
          "docs": "Returns a list of available financial and technology management reports"
        }
      ]
    }
  ],
  "bundled": true
}